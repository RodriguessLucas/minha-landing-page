---
import { Image } from "astro:assets";
import foto from "../assets/fotodelucas.png";
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,#101012_0%,#0c0c0e_100%)]" aria-hidden="true"></div>
  <div class="absolute inset-0 opacity-40" aria-hidden="true">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-accent-500/20 rounded-full blur-3xl animate-float"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-gold-400/10 rounded-full blur-3xl animate-float" style="animation-delay: -3s;"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 py-24 lg:py-32">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="text-center lg:text-left animate-fade-up">
        <p class="text-sm font-medium text-accent-400 tracking-wider uppercase mb-6 animate-fade-in" style="animation-delay: 100ms;">
          Desenvolvedor Full Stack
        </p>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-4 animate-fade-up" style="animation-delay: 200ms;">
          Lucas <span class="text-accent-400">Rodrigues</span> Pereira
        </h1>
        <p class="text-lg md:text-xl text-gray-300 max-w-xl mx-auto lg:mx-0 mb-4 animate-fade-up" style="animation-delay: 300ms;">
          Construo aplicações web, mobile e APIs de ponta a ponta — do design à entrega —
          usando Java e Spring Boot no backend e Angular, React, Next.js e React Native no frontend.
        </p>
        <p class="text-sm text-ink-400 max-w-xl mx-auto lg:mx-0 mb-8 animate-fade-up" style="animation-delay: 350ms;">
          Java · Spring Boot · Angular · React · Next.js · React Native · PostgreSQL · MongoDB · Docker
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start animate-fade-up" style="animation-delay: 400ms;">
          <a
            href="#contato"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-accent-500 hover:bg-accent-400 text-ink-900 font-semibold rounded-lg transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-900"
          >
            Vamos conversar
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/assets/docs/CV_Lucas_Rodrigues_Pereira_v2_pt.pdf"
            download="Curriculo-Lucas-Rodrigues-Pereira.pdf"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-accent-500 text-accent-400 font-medium rounded-lg hover:bg-accent-500/10 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-900"
          >
            Baixar CV
          </a>
          <a
            href="https://github.com/RodriguessLucas"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-ink-600 hover:border-accent-500 text-ink-300 hover:text-white font-medium rounded-lg transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-900"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 3.286-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
            GitHub
          </a>
        </div>
      </div>

      <div class="relative animate-fade-in" style="animation-delay: 600ms;">
        <div class="relative mx-auto max-w-sm">
          <div class="absolute inset-0 bg-gradient-to-br from-accent-500/30 via-transparent to-gold-400/20 rounded-3xl blur-2xl animate-pulse-glow"></div>
          <div class="relative rounded-3xl overflow-hidden border border-ink-600 bg-ink-800/50 shadow-2xl">
            <Image
              src={foto}
              alt="Retrato de Lucas Rodrigues Pereira, desenvolvedor full stack"
              widths={[320, 640]}
              sizes="(max-width: 1024px) 90vw, 400px"
              loading="eager"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink-900/90 via-ink-900/30 to-transparent" aria-hidden="true"></div>
          </div>
          <div class="absolute -bottom-5 -right-3 hidden sm:flex items-center gap-3 rounded-2xl border border-ink-600 bg-ink-900/90 backdrop-blur px-4 py-3 shadow-xl">
            <span class="w-2.5 h-2.5 rounded-full bg-accent-400 animate-pulse" aria-hidden="true"></span>
            <span class="text-xs font-medium text-ink-200">Disponível para novos projetos</span>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
      <svg class="w-6 h-6 text-ink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>

---
import { Image } from "astro:assets";
import capa from "../assets/capadeprojetosoftware.jpg";

const projects = [
  {
    title: "Aquatrat",
    description:
      "Sistema construído do zero com dashboard analítica em Angular, simuladores financeiros em tempo real, geração automatizada de PDFs corporativos e autenticação OAuth 2FA. Inclui testes unitários e de integração.",
    alt: "Capa do projeto Aquatrat — dashboard analítico",
    tags: ["Java", "Spring Boot", "Angular", "PostgreSQL"],
    link: "https://github.com/RodriguessLucas",
  },
  {
    title: "Oftlessons",
    description:
      "Plataforma educacional gamificada desenvolvida ponta a ponta — mobile, web e backend — com publicação do app nas lojas Google Play e App Store e flashcards com repetição espaçada e IA.",
    alt: "Capa do projeto Oftlessons — plataforma educacional",
    tags: ["React Native", "Next.js", "Java", "MongoDB"],
    link: "https://github.com/RodriguessLucas",
  },
  {
    title: "Plataforma Jurídica",
    description:
      "Gestão de escritórios de advocacia: colaboradores, parceiros, advogados e clientes PF/PJ, processos em Kanban com custos e histórico, módulo financeiro com apuração de lucro por cliente e relatórios em PDF personalizados.",
    alt: "Capa da plataforma de gestão jurídica",
    tags: ["Java", "Spring Boot", "PostgreSQL", "React"],
    link: "https://github.com/RodriguessLucas",
  },
  {
    title: "TrampoUp",
    description:
      "Marketplace de serviços SaaS com chat integrado, match por geolocalização e sistema de avaliações, operando com autenticação e dados relacionais em escala.",
    alt: "Capa do marketplace TrampoUp",
    tags: ["Java", "Spring Boot", "Angular", "Docker"],
    link: "https://github.com/RodriguessLucas",
  },
  {
    title: "Aprova UFC",
    description:
      "Plataforma de ensino e simulados para alunos de escola pública e baixa renda, com microsserviço de classificação automática de questões a partir do banco de dados do ENEM.",
    alt: "Capa da plataforma Aprova UFC",
    tags: ["React", "Spring Boot", "MySQL"],
    link: "https://github.com/RodriguessLucas",
  },
  {
    title: "Auxílio ao Aquarismo",
    description:
      "SPA para simulação de ecossistemas aquáticos e validação de compatibilidade entre peixes, com motor de regras de negócio (pH, superlotação, predação) e cálculos em tempo real.",
    alt: "Capa da plataforma de auxílio ao aquarismo",
    tags: ["Spring Boot", "PostgreSQL", "Docker"],
    link: "https://github.com/RodriguessLucas",
  },
];
---

<section id="projetos" class="py-24 px-6 bg-ink-900">
  <div class="mx-auto max-w-7xl">
    <div class="text-center mb-16">
      <p class="text-sm font-medium text-accent-400 tracking-wider uppercase mb-4 animate-fade-up">Portfólio</p>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4 animate-fade-up" style="animation-delay: 100ms;">
        Projetos em Destaque
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto animate-fade-up" style="animation-delay: 150ms;">
        Seleção de trabalhos que demonstram minha abordagem técnica e atenção aos detalhes.
      </p>
      <div class="w-16 h-1 bg-accent-500 mx-auto mt-6 animate-fade-up" style="animation-delay: 200ms;"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {
        projects.map((project, i) => (
          <article class="group rounded-2xl overflow-hidden border border-ink-700 bg-ink-800/50 hover:border-accent-500/50 transition-colors duration-300 animate-fade-up" style={`animation-delay: ${300 + i * 100}ms;`}>
            <div class="relative aspect-video overflow-hidden bg-ink-700">
              <Image
                src={capa}
                alt={project.alt}
                widths={[400, 800]}
                sizes="(max-width: 768px) 90vw, 560px"
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-transparent to-transparent opacity-70" aria-hidden="true" />
            </div>
            <div class="p-6">
              <h3 class="font-display text-xl font-bold text-white mb-3 group-hover:text-accent-400 transition-colors duration-200">
                {project.title}
              </h3>
              <p class="text-gray-400 text-sm leading-relaxed mb-5">{project.description}</p>
              <ul class="flex flex-wrap gap-2 list-none">
                {project.tags.map((tag) => (
                  <li class="px-2.5 py-1 text-xs font-medium text-accent-400 bg-accent-500/10 border border-accent-500/25 rounded">{tag}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 text-center animate-fade-up" style="animation-delay: 600ms;">
      <a
        href="https://github.com/RodriguessLucas"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 border border-ink-600 hover:border-accent-500 text-gray-300 hover:text-white font-medium rounded-lg transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-900"
      >
        Ver mais no GitHub
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>

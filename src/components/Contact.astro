---
const email = "rodrigues.lrp17@gmail.com";
const linkedin = "https://www.linkedin.com/in/rodriguesslucas/";
const github = "https://github.com/RodriguessLucas";
---

<section id="contato" class="py-24 px-6 bg-ink-800/50">
  <div class="mx-auto max-w-4xl">
    <div class="text-center mb-16">
      <p class="text-sm font-medium text-accent-400 tracking-wider uppercase mb-4 animate-fade-up">Vamos conversar</p>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4 animate-fade-up" style="animation-delay: 100ms;">
        Entre em Contato
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto animate-fade-up" style="animation-delay: 150ms;">
        Tem um projeto em mente ou quer conversar sobre oportunidades? Estou disponível para novos desafios.
      </p>
      <div class="w-16 h-1 bg-accent-500 mx-auto mt-6 animate-fade-up" style="animation-delay: 200ms;"></div>
    </div>

    <div class="grid gap-8 animate-fade-up" style="animation-delay: 300ms;">
      <div class="rounded-2xl border border-ink-700 bg-ink-900/60 p-8 md:p-10">
        <h3 class="font-display text-xl font-bold text-white mb-6">Canais de contato</h3>

        <div class="space-y-4">
          <a
            href={`mailto:${email}`}
            class="flex items-center gap-4 p-4 rounded-xl border border-ink-600 hover:border-accent-500 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-900 group"
          >
            <span class="flex-shrink-0 w-11 h-11 rounded-lg bg-accent-500/10 border border-accent-500/20 flex items-center justify-center text-accent-400 group-hover:bg-accent-500/20 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm text-gray-500">E-mail</span>
              <span class="block text-gray-200 font-medium truncate">{email}</span>
            </span>
            <svg class="w-5 h-5 text-gray-600 ml-auto flex-shrink-0 group-hover:text-accent-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>

          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl border border-ink-600 hover:border-accent-500 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-900 group"
          >
            <span class="flex-shrink-0 w-11 h-11 rounded-lg bg-accent-500/10 border border-accent-500/20 flex items-center justify-center text-accent-400 group-hover:bg-accent-500/20 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm text-gray-500">LinkedIn</span>
              <span class="block text-gray-200 font-medium truncate">linkedin.com/in/rodriguesslucas</span>
            </span>
            <svg class="w-5 h-5 text-gray-600 ml-auto flex-shrink-0 group-hover:text-accent-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>

          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 rounded-xl border border-ink-600 hover:border-accent-500 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-900 group"
          >
            <span class="flex-shrink-0 w-11 h-11 rounded-lg bg-accent-500/10 border border-accent-500/20 flex items-center justify-center text-accent-400 group-hover:bg-accent-500/20 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm text-gray-500">GitHub</span>
              <span class="block text-gray-200 font-medium truncate">github.com/RodriguessLucas</span>
            </span>
            <svg class="w-5 h-5 text-gray-600 ml-auto flex-shrink-0 group-hover:text-accent-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>

          <div class="flex items-center gap-4 p-4 rounded-xl border border-ink-600">
            <span class="flex-shrink-0 w-11 h-11 rounded-lg bg-ink-700/60 flex items-center justify-center text-gray-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 12.414a4 4 0 10-1.414-1.414l4.243 4.243a2 2 0 11-2.829 2.829l-4.243-4.243a6 6 0 108.485 8.485z"/></svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm text-gray-500">Localização</span>
              <span class="block text-gray-200 font-medium">Fortaleza / Russas, CE — Brasil</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
const timeline = [
  {
    period: "Ago 2025 — Atual",
    role: "Desenvolvedor Full Stack",
    company: "DRC Consultoria em TI · Remoto",
    highlights: [
      "Aquatrat: dashboard analítica em Angular, simuladores financeiros em tempo real, PDFs automatizados e OAuth 2FA",
      "Obraplan: listagens paginadas de 8–11s para menos de 1,5s com batch fetching e índices compostos",
      "Oftlessons: plataforma educacional gamificada publicada no Google Play e App Store",
      "Plataforma jurídica: processos em Kanban, módulo financeiro e relatórios em PDF personalizados",
      "TrampoUp: marketplace SaaS com chat, match por geolocalização e avaliações",
    ],
  },
  {
    period: "Mai 2025 — Jan 2026",
    role: "Desenvolvedor Backend",
    company: "NERDS (UFC) · Russas, CE",
    highlights: [
      "Sistema de atividades de extensão da Pró-Reitoria de Extensão da UFC em arquitetura de microsserviços",
      "Metodologia ágil com Scrum: sprints semanais, dailies e retrospectivas",
    ],
  },
  {
    period: "Atuação recente",
    role: "Desenvolvedor Full Stack Freelancer",
    company: "Remoto",
    highlights: [
      "Landing pages institucionais para 3 empresas, incluindo a Gelo Tigre",
      "SEO técnico, robots.txt, metadados e indexação por mecanismos de busca por IA",
      "Performance guiada por PageSpeed Insights e monitoramento via Google Search Console",
    ],
  },
];
---

<section id="sobre" class="py-24 px-6 bg-ink-900">
  <div class="mx-auto max-w-7xl">
    <div class="text-center mb-16">
      <p class="text-sm font-medium text-accent-400 tracking-wider uppercase mb-4 animate-fade-up">Minha história</p>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4 animate-fade-up" style="animation-delay: 100ms;">
        Sobre Mim
      </h2>
      <div class="w-16 h-1 bg-accent-500 mx-auto animate-fade-up" style="animation-delay: 200ms;"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <div class="space-y-6 animate-fade-up" style="animation-delay: 300ms;">
        <h3 class="font-display text-2xl md:text-3xl font-bold text-white">
          Desenvolvedor com foco em produto e performance
        </h3>
        <p class="text-lg text-gray-300 leading-relaxed">
          Desenvolvedor Full Stack com experiência prática na construção de aplicações web, mobile e APIs
          de ponta a ponta. Sou proficiente no ecossistema Java com Spring Boot no backend e em frameworks
          frontend modernos como Angular, React, Next.js e React Native.
        </p>
        <p class="text-lg text-gray-300 leading-relaxed">
          Tenho forte vivência em modelagem de bancos de dados relacionais e NoSQL, arquitetura de
          microsserviços, automação com Docker e CI/CD, entregando produtos para clientes reais em SaaS,
          plataformas educacionais e sistemas institucionais. Gosto de medir antes de otimizar — foi assim que
          reduzi listagens paginadas de 8–11s para menos de 1,5s no Obraplan.
        </p>
        <ul class="grid md:grid-cols-2 gap-4 text-gray-300">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Arquitetura de microsserviços e APIs REST</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Publicação de apps em Google Play e App Store</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Otimização de performance guiada por métricas</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Automação de CI/CD e backup sem intervenção</span>
          </li>
        </ul>

        <div class="grid grid-cols-2 gap-3 pt-2">
          <div class="rounded-xl border border-ink-700 bg-ink-800/50 px-4 py-3 text-center">
            <p class="font-display text-xl font-bold text-accent-400">UFC</p>
            <p class="text-xs text-gray-500 mt-1">Ciência da Computação · 6º semestre</p>
          </div>
          <div class="rounded-xl border border-ink-700 bg-ink-800/50 px-4 py-3 text-center">
            <p class="font-display text-xl font-bold text-accent-400">6+</p>
            <p class="text-xs text-gray-500 mt-1">Projetos entregues</p>
          </div>
        </div>
      </div>

      <div class="relative animate-fade-up" style="animation-delay: 350ms;">
        <div class="absolute left-[7px] top-2 bottom-2 w-px bg-gradient-to-b from-accent-500 via-accent-500/30 to-transparent" aria-hidden="true"></div>

        <ol class="space-y-8">
          {
            timeline.map((item) => (
              <li class="relative pl-10">
                <span class="absolute left-0 top-1.5 w-[15px] h-[15px] rounded-full border-2 border-accent-500 bg-ink-900" aria-hidden="true" />
                <p class="text-xs font-medium text-accent-400 tracking-wide uppercase">{item.period}</p>
                <h3 class="font-display text-lg font-bold text-white mt-1">{item.role}</h3>
                <p class="text-sm text-gray-500 mb-3">{item.company}</p>
                <ul class="space-y-2">
                  {item.highlights.map((h) => (
                    <li class="flex items-start gap-2.5 text-sm text-gray-400 leading-relaxed">
                      <svg class="w-4 h-4 text-accent-500/70 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

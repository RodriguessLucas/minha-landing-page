---
const timeline = [
  {
    period: "2025 — Atual",
    role: "Desenvolvedor Full Stack",
    company: "Consultoria (cliente sob NDA) · Remoto",
    highlights: [
      "Projeto 1: dashboard analítica em Angular, simuladores financeiros em tempo real, PDFs automatizados e OAuth 2FA",
      "Projeto 2: otimização de listagens paginadas de 8–11s para <1,5s com batch fetching e índices compostos",
      "Projeto 3: plataforma educacional gamificada publicada no Google Play e App Store",
      "Projeto 4: gestão de escritórios, processos em Kanban, módulo financeiro e relatórios PDF",
      "Projeto 5: marketplace SaaS com chat, match por geolocalização e avaliações",
    ],
  },
  {
    period: "2025",
    role: "Desenvolvedor Backend",
    company: "NERDS (UFC) · Russas, CE",
    highlights: [
      "Sistema de atividades de extensão da Pró-Reitoria de Extensão da UFC em microsserviços",
      "Metodologia ágil: Scrum com sprints semanais, dailies e retrospectivas",
    ],
  },
  {
    period: "2024 — Atual",
    role: "Desenvolvedor Full Stack Freelancer",
    company: "Remoto",
    highlights: [
      "Landing pages para empresas (Gelo Tigre, entre outras)",
      "SEO técnico: robots.txt, metadados e indexação por busca por IA",
      "Performance guiada por PageSpeed Insights e Google Search Console",
    ],
  },
];
---

<section id="sobre" class="py-24 px-6 bg-ink-900">
  <div class="mx-auto max-w-7xl">
    <div class="text-center mb-16">
      <p class="text-sm font-medium text-accent-400 tracking-wider uppercase mb-4 animate-fade-up">
        Minha história
      </p>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4 animate-fade-up" style="animation-delay: 100ms;">
        Sobre Mim
      </h2>
      <div class="w-16 h-1 bg-accent-500 mx-auto animate-fade-up" style="animation-delay: 200ms;"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <div class="space-y-6 animate-fade-up" style="animation-delay: 300ms;">
        <h3 class="font-display text-2xl md:text-3xl font-bold text-white">
          Desenvolvedor com foco em produto e performance
        </h3>
        <p class="text-lg text-gray-300 leading-relaxed">
          Sou Desenvolvedor Full Stack com experiência prática na construção de aplicações web,
          mobile e APIs de ponta a ponta — proficiente no ecossistema Java (Spring Boot) no
          backend e em Angular, React, Next.js e React Native no frontend.
        </p>
        <p class="text-lg text-gray-300 leading-relaxed">
          Tenho forte vivência em arquitetura de microsserviços, automação com Docker/CI-CD e
          entrega de produtos reais. Gosto de medir antes de otimizar: reduzi listagens paginadas
          <span class="font-bold text-accent-400"> de 8–11s para menos de 1,5s</span> em um projeto
          de grande escala.
        </p>

        <ul class="grid md:grid-cols-2 gap-4 text-gray-300">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Arquitetura de microsserviços e APIs REST</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Publicação de apps em Google Play e App Store</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Otimização de performance guiada por métricas</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Automação de CI/CD e deploy sem intervenção</span>
          </li>
        </ul>

        <div class="grid grid-cols-2 gap-3 pt-2">
          <div class="rounded-xl border border-ink-700 bg-ink-800/50 px-4 py-3 text-center">
            <p class="font-display text-2xl md:text-3xl font-bold text-accent-400">UFC</p>
            <p class="text-xs text-ink-500 mt-1">Ciência da Computação · 6º semestre</p>
          </div>
          <div class="rounded-xl border border-ink-700 bg-ink-800/50 px-4 py-3 text-center">
            <p class="font-display text-2xl md:text-3xl font-bold text-accent-400">6+</p>
            <p class="text-xs text-ink-500 mt-1">Projetos entregues</p>
          </div>
        </div>
      </div>

      <div class="relative animate-fade-up" style="animation-delay: 350ms;">
        <div class="absolute left-[7px] top-2 bottom-2 w-px bg-gradient-to-b from-accent-500 via-accent-500/30 to-transparent" aria-hidden="true"></div>

        <ol class="space-y-8">
          {timeline.map((item) => (
            <li class="relative pl-10">
              <span class="absolute left-0 top-1.5 w-[15px] h-[15px] rounded-full border-2 border-accent-500 bg-ink-900" aria-hidden="true" />
              <p class="text-xs font-medium text-accent-400 tracking-wide uppercase">{item.period}</p>
              <h3 class="font-display text-lg font-bold text-white mt-1">{item.role}</h3>
              <p class="text-sm text-ink-400 mb-3">{item.company}</p>
              <ul class="space-y-2">
                {item.highlights.map((h) => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-300 leading-relaxed">
                    <svg class="w-4 h-4 text-accent-500/70 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
